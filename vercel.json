{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "installCommand": "cd world && npm install",
  "buildCommand": "cd world && npm run build && cd .. && rm -rf .vercel-out && mkdir -p .vercel-out/simulation && cp -r docs/. .vercel-out/ && cp -r world/dist/. .vercel-out/simulation/",
  "outputDirectory": ".vercel-out",
  "cleanUrls": true,
  "redirects": [
    { "source": "/sim", "destination": "/simulation", "permanent": false },
    { "source": "/world", "destination": "/simulation", "permanent": false }
  ],
  "headers": [
    {
      "source": "/assets/(.*)",
      "headers": [{ "key": "Cache-Control", "value": "public, max-age=86400" }]
    },
    {
      "source": "/simulation/assets/(.*)",
      "headers": [{ "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }]
    }
  ]
}
