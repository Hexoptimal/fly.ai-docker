{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "installCommand": "cd world && npm install && cd ../flybook/web && npm install",
  "buildCommand": "bash scripts/vercel-build.sh",
  "outputDirectory": ".vercel-out",
  "cleanUrls": true,
  "redirects": [
    {
      "source": "/:path(.*)",
      "has": [
        {
          "type": "host",
          "value": "www.flyaiworld.com"
        }
      ],
      "destination": "https://flyaiworld.com/:path",
      "permanent": true
    },
    {
      "source": "/sim",
      "destination": "/simulation",
      "permanent": false
    },
    {
      "source": "/world",
      "destination": "/simulation",
      "permanent": false
    },
    {
      "source": "/flybook",
      "destination": "/flybook/",
      "permanent": false
    }
  ],
  "headers": [
    {
      "source": "/assets/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=86400"
        }
      ]
    },
    {
      "source": "/simulation/assets/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/flybook/assets/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    }
  ]
}
