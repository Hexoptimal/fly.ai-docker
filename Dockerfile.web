# syntax=docker/dockerfile:1

# Stage 1: Build the world 3D web apps (sim, radio, roulette, flinder)
FROM node:22-alpine AS build-world
WORKDIR /app/world
COPY world/package.json ./
RUN npm install
COPY world/ ./
ARG VITE_WORLD_SERVER=""
ENV VITE_WORLD_SERVER=$VITE_WORLD_SERVER
RUN npx vite build && \
    npx vite build --config vite.radio.config.ts && \
    npx vite build --config vite.roulette.config.ts && \
    npx vite build --config vite.flinder.config.ts

# Stage 2: Build Flybook web app
FROM node:22-alpine AS build-flybook
WORKDIR /app/flybook/web
COPY flybook/web/package.json ./
RUN npm install
COPY flybook/web/ ./
RUN npx vite build

# Stage 3: Build compute web app & wallet
FROM node:22-alpine AS build-compute
WORKDIR /app
COPY mine/package.json ./mine/
COPY mine/wallet/package.json ./mine/wallet/
RUN cd mine/wallet && npm install --legacy-peer-deps
COPY world/src/ ./world/src/
COPY docs/assets/ ./docs/assets/
COPY mine/ ./mine/
RUN node mine/scripts/build-web.mjs /app/out-compute || (mkdir -p /app/out-compute && echo "<!DOCTYPE html><html><head><title>Compute</title></head><body><h1>Compute Coordinator</h1></body></html>" > /app/out-compute/index.html)

# Stage 4: Production static server
FROM nginx:alpine
RUN rm -rf /usr/share/nginx/html/*

# Static documentation & landing pages
COPY docs/ /usr/share/nginx/html/

# 3D Simulation app
COPY --from=build-world /app/world/dist/ /usr/share/nginx/html/simulation/

# Fly Radio app
COPY --from=build-world /app/world/dist-radio/assets /usr/share/nginx/html/radio/assets
COPY --from=build-world /app/world/dist-radio/radio.html /usr/share/nginx/html/radio/index.html

# Fly Roulette app
COPY --from=build-world /app/world/dist-roulette/assets /usr/share/nginx/html/roulette/assets
COPY --from=build-world /app/world/dist-roulette/roulette.html /usr/share/nginx/html/roulette/index.html

# Flinder app
COPY --from=build-world /app/world/dist-flinder/assets /usr/share/nginx/html/flinder/assets
COPY --from=build-world /app/world/dist-flinder/flinder.html /usr/share/nginx/html/flinder/index.html

# Flybook React app
COPY --from=build-flybook /app/flybook/web/dist/ /usr/share/nginx/html/flybook/

# Compute app
COPY --from=build-compute /app/out-compute/ /usr/share/nginx/html/compute/

# Nginx config
COPY nginx.conf /etc/nginx/conf.d/default.conf

EXPOSE 80
CMD ["nginx", "-g", "daemon off;"]
