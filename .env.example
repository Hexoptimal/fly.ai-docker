# ==============================================================================
# fly.ai Docker Compose Environment Configuration
# ==============================================================================
# Copy this file to .env and adjust the settings as needed:
#   cp .env.example .env
# ==============================================================================

# ------------------------------------------------------------------------------
# Persistent Data Storage Base Directory
# ------------------------------------------------------------------------------
# Subfolders (e.g. ./data/world, ./data/brain, ./data/compute) will be created automatically.
DATA_DIR=./data

# ------------------------------------------------------------------------------
# Host Port Mappings (Configure these to match your host/reverse proxy setup)
# ------------------------------------------------------------------------------
WEB_PORT=3000          # Static Web Apps & Docs (http://your-server:3000)
WORLD_SIM_PORT=8082    # 3D World Simulation Live Server (http://your-server:8082)
FLYBOOK_API_PORT=8081  # Flybook REST API (http://your-server:8081)
COMPUTE_PORT=8787      # Compute / Mining Coordinator (http://your-server:8787)

# ------------------------------------------------------------------------------
# World Simulation Settings
# ------------------------------------------------------------------------------
# WORLD_SINK: 'files' (saves locally to volume) or 'supabase'
WORLD_SINK=files
WORLD_SEED=1234
WORLD_START_FLIES=24
WORLD_MIN_FLIES=8
WORLD_MAX_FLIES=40
WORLD_ORIGINS=*
# Synchronize in-world time of day, clock, and daylight with the real 24-hour clock (1 = on, 0 = 5-min cycle)
WORLD_REALTIME_CLOCK=1
WORLD_DAY_LENGTH=86400

# ------------------------------------------------------------------------------
# Flybook & Worker Settings (Optional - required for full Flybook database integration)
# ------------------------------------------------------------------------------
# SUPABASE_URL=https://your-project.supabase.co
# SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key
FLYBOOK_ORIGINS=*
FLYBOOK_MAX_FLIES=3
FLYBOOK_MIN_TOKENS=1
TICK_INTERVAL=120
NUMBA_NUM_THREADS=4
ROBINHOOD_RPC=https://rpc.mainnet.chain.robinhood.com

# Optional OpenRouter key for AI meme generation in Flybook
# OPENROUTER_API_KEY=your-openrouter-key

# ------------------------------------------------------------------------------
# Compute & Mining Server Settings
# ------------------------------------------------------------------------------
# ADMIN_TOKEN for authenticated compute admin snapshots and endpoints
# ADMIN_TOKEN=your-random-admin-token
